# Example only. Load into the service environment; the app does not parse this file.
# Keep the actual env file outside git with restricted permissions.
FILAMENT_PICKER_SESSION_SECRET=change-me
# Model preview account. Set the real name only in the server env file.
# Empty or this placeholder rejects every preview login; there is no default name.
FILAMENT_PICKER_PREVIEW_USER=change-me-preview-user
FILAMENT_PICKER_AUTH_DB=/srv/filament-picker/auth/users.sqlite
FILAMENT_PICKER_MODELS_ROOT=/srv/filament-picker/models/private
FILAMENT_PICKER_SESSION_TTL=604800
FILAMENT_PICKER_SESSION_SECURE=1
FILAMENT_PICKER_MODELS_DIRECT=0
# Server-side original download. Leave the secrets empty here; put real values only in
# the service environment. The browser never receives the bucket, key, or a signed URL.
# FILAMENT_PICKER_COS_BUCKET=filament-backup-1385670520
# FILAMENT_PICKER_COS_REGION=ap-shanghai
# FILAMENT_PICKER_COS_PREFIX=filament-picker/3mf-originals/20261107/
# FILAMENT_PICKER_COS_SECRET_ID=
# FILAMENT_PICKER_COS_SECRET_KEY=
# FILAMENT_PICKER_COS_TOKEN=
# FILAMENT_PICKER_COS_TIMEOUT_SECONDS=120
# Optional JSON object: {"model-id": "relative/key.3mf"} or {"model-id": {"key": "...", "sha256": "..."}}
# FILAMENT_PICKER_COS_MAP=/srv/filament-picker/cos-map.json
# Test-only host override. Leave unset in production.
# FILAMENT_PICKER_COS_ENDPOINT=
# FILAMENT_PICKER_COS_SECURE=1
