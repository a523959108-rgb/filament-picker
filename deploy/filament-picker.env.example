# Example only. Load into the service environment; the app does not parse this file.
# Keep the actual env file outside git with restricted permissions.
FILAMENT_PICKER_SESSION_SECRET=change-me
# Model preview account. Set the real name only in the server env file.
# Empty or this placeholder rejects every preview login; there is no default name.
FILAMENT_PICKER_PREVIEW_USER=change-me-preview-user
FILAMENT_PICKER_AUTH_DB=/srv/filament-picker/auth/users.sqlite
FILAMENT_PICKER_MODELS_ROOT=/srv/filament-picker/models/private
FILAMENT_PICKER_SESSION_TTL=604800
FILAMENT_PICKER_SESSION_SECURE=1
FILAMENT_PICKER_MODELS_DIRECT=0
