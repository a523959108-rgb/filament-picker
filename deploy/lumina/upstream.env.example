# 复制为本目录的 upstream.env，或 /etc/lumina/upstream.env。这两个路径都不提交。
# ufw.sh 与 render-nginx.sh 只填充尚未导出的变量。LUMINA_UPSTREAM_ENV 指向别的文件时，只读那一个。
# 格式：KEY=VALUE，不要加引号、空格或 shell 展开。
# Docker Compose 不读本文件。主力 docker/.env 里要再写同一个 LUMINA_UPSTREAM_HOST，见 docker/.env.example。

# 边缘机 B 的 Tailscale 地址。防火墙只允许这个来源访问后端端口。
LUMINA_EDGE_HOST=
# 主力机的 Tailscale 地址，以及 Docker 发布在该地址上的端口。容器内仍监听 8790。
LUMINA_UPSTREAM_HOST=
LUMINA_UPSTREAM_PORT=7860
# 备用机 C 的地址和端口。
LUMINA_UPSTREAM_BACKUP_HOST=
LUMINA_UPSTREAM_BACKUP_PORT=8790
