# 主力 zhou-mini-gtx 的 venv/systemd 备选；默认部署请用 docker/compose.yaml。
# 本文件是 systemd EnvironmentFile，使用不带引号的 KEY=VALUE。
# api_server.py 仅接受 0.0.0.0 或 127.0.0.1；双机均经 UFW 限 B 访问。
LUMINA_API_HOST=0.0.0.0
# TCP 端口，整数 1024..65535；B upstream 与 UFW 必须一致。
LUMINA_API_PORT=7860
# 1 启用后端托管生产前端，无需在后端安装 nginx。
LUMINA_SERVE_FRONTEND_DIST=1
# 前端绝对路径，跟随 current 原子切换。
LUMINA_FRONTEND_DIST_DIR=/opt/lumina/current/frontend/dist
# 可写耗材库绝对路径；两台各自本地保存。
LUMINA_MATERIALS_DIR=/var/lib/lumina/materials
# 派生求解缓存的绝对根目录，实际写到其 _solver_cache/ 子目录；不是预览缓存。
LUMINA_RUNTIME_CACHE_DIR=/var/lib/lumina/cache
# 单次预览缓存估算上限，单位字节；0/空/非法值会禁用保护。此处选 256 MiB。
LUMINA_PREVIEW_CACHE_MAX_BYTES=268435456
# JSONL 日志文件绝对路径，不是目录；需配合运维日志轮转。
LUMINA_LOG_PATH=/var/log/lumina/lumina.jsonl
# 安装器首次创建 env 时按 max(1,nproc-2) 填入；已有 env 不覆盖。
# 这里的 CHANGE_ME 是占位；手动部署时也须改为整数，按实测内存容量降低并发。
LUMINA_MAX_WORKERS=CHANGE_ME
# 以下三项由 install.sh 读取生成 systemd drop-in，上游不读取。
# 主力 8核16线程 / 20G（可用约16G），仍需为 HA 等服务保留额度。
# 备选 systemd 总内存上限含主进程和全部 worker；默认 docker 使用8G。
# 必须人工填入实际额度；占位值会阻止安装，不能照搬 C 的 2.5G。
LUMINA_MEMORY_MAX=CHANGE_ME
# 主力额外 swap 上限待定，单位 M/G 或 0；必须人工填写。
LUMINA_MEMORY_SWAP_MAX=CHANGE_ME
# 主力 CPU 配额待定，例如 600% 表示最多 6 核；须结合其他服务填写。
LUMINA_CPU_QUOTA=CHANGE_ME
# E 块提供的本地 seed zip 绝对路径；可空，且仅空耗材库首次启动时导入。
LUMINA_MATERIALS_SEED_PATH=
# 设置文件必须为绝对路径，避开只读 release 的 user_settings.json。
LUMINA_SETTINGS_PATH=/opt/lumina/shared/user_settings.json
# 创意工坊可写数据绝对目录，避免依赖登录用户 HOME。
LUMINA_WORKSHOP_DATA_DIR=/opt/lumina/shared/workshop
# 反馈工件可写绝对目录（保留上游 origin guard）。
LUMINA_FEEDBACK_DUMP_DIR=/var/lib/lumina/output/feedback
# 禁用 GPU 发现；安装器另外拒绝 CUDA 依赖。
CUDA_VISIBLE_DEVICES=-1
# Python 不往只读源码目录写 __pycache__。
PYTHONDONTWRITEBYTECODE=1
# Numba 编译缓存绝对目录；源码有 cache=True 的 JIT。
NUMBA_CACHE_DIR=/var/lib/lumina/cache/numba
# 第三方库缓存和用户数据的绝对根目录。
XDG_CACHE_HOME=/var/lib/lumina/cache/xdg
XDG_DATA_HOME=/opt/lumina/shared/xdg
# BLAS/OpenMP 每个 worker 使用一个线程，避免 2 核过度争用。
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
