.venv/
web/node_modules/
web/dist/
# Ignore build artifacts, but keep the deploy catalog tracked.
# `data/build/*` (not `data/build/`) so the negation below can re-include one file.
data/build/*
!data/build/filament-catalog.json
data/extracted/
data/qa/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
data/auth/
data/models-private/
.env
.env.*
!.env.example
deploy/*.env
# Tailscale / upstream addresses stay on the server. See deploy/lumina/upstream.env.example.
upstream.env
deploy/lumina/nginx-b-stack.local.conf
# Frontend production tarball is built at release time. See deploy/DEPLOY.md.
deploy/release/dist.tgz
