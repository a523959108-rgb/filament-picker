{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filament-picker.local/schemas/request.schema.json",
  "title": "inbox/<request_id>.request.json（钉钉助手 → worker）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "created_at", "image_paths"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9_.=+-]{1,200}$", "description": "= 监听器清洗后的 msgId：re.sub(r'[^A-Za-z0-9_.=+-]', '_', msgId)"},
    "created_at": {"type": "string", "format": "date-time"},
    "image_paths": {
      "type": "array", "minItems": 1, "maxItems": 9,
      "items": {"type": "string", "pattern": "^/.+\\.(png|jpg|gif|webp|bmp|heic|bin)$"},
      "description": "监听器 payload 里的 image_paths 原样复制；v1 只处理第 1 张"
    },
    "note": {"type": "string", "maxLength": 500, "default": "", "description": "用户随图文字（richText 的 text 部分，或上一条文字消息）"},
    "regions": {"$ref": "#/$defs/sampleRegions"},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "description": "显式约束，优先级高于 note 解析结果",
      "properties": {
        "max_colors": {"type": "integer", "minimum": 1, "maximum": 16},
        "ams_slots": {"type": "integer", "minimum": 1, "maximum": 16},
        "materials": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PLA", "PETG"]}},
        "brands": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
        "allow_approx": {"type": "boolean"},
        "keep_small": {"type": "boolean"},
        "per_color": {"type": "integer", "minimum": 1, "maximum": 3},
        "regions": {"$ref": "#/$defs/sampleRegions"}
      }
    },
    "context": {
      "type": "object",
      "maxProperties": 20,
      "description": "钉钉助手自用的上下文（如 conversationId、senderStaffId），worker 原样回写到 result.context。禁止放 sessionWebhook。",
      "not": {"anyOf": [{"required": ["sessionWebhook"]}, {"required": ["session_webhook"]}]}
    }
  },
  "$defs": {
    "sampleRegion": {
      "type": "object",
      "additionalProperties": false,
      "description": "矩形给 x,y,w,h（左上角+宽高）；点击点只给 x,y，可选 r。space 缺省为 norm。",
      "properties": {
        "space": {"enum": ["norm", "px"], "description": "norm：相对原图宽高的 0–1；px：原图像素"},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "w": {"type": "number", "exclusiveMinimum": 0},
        "h": {"type": "number", "exclusiveMinimum": 0},
        "r": {"type": "number", "exclusiveMinimum": 0, "description": "点的取样半径。norm 时是短边的比例，px 时是像素。缺省为短边的 4%"}
      },
      "oneOf": [
        {"required": ["x", "y", "w", "h"]},
        {"required": ["x", "y"], "not": {"anyOf": [{"required": ["w"]}, {"required": ["h"]}]}}
      ]
    },
    "sampleRegions": {
      "type": "array",
      "maxItems": 16,
      "description": "只在这些区域的并集里取样（仍套用前景掩码）。constraints.regions 优先于顶层 regions。空数组表示整张图。",
      "items": {"$ref": "#/$defs/sampleRegion"}
    }
  }
}
