{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filament-picker.local/schemas/ids.lock.schema.json",
  "title": "ids.lock.json（颜色 ID 锁定表，提交进仓库，只增不改）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules_version", "updated_at", "source_sha256", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "rules_version": {"const": "slug-v1", "description": "SPEC §5 的规则版本；规则变更必须升版本并由人决定迁移"},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "由 --today 参数给出，默认本地日期"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "最近一次 assign-ids 时 page_rows.json 的 sha256"},
    "entries": {
      "type": "object",
      "description": "key = dedup_key（见 SPEC §5.6），按 key 字典序写出",
      "propertyNames": {"pattern": "^[a-z0-9-]+\\|.+\\|.+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "first_seen", "last_seen"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 190},
          "status": {"enum": ["active", "retired"]},
          "first_seen": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "last_seen": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
